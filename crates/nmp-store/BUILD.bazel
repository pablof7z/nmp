# First-party BUILD for the `nmp-store` crate. Third-party deps come from
# @crates via all_crate_deps(); first-party path deps are explicit.

load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

rust_library(
    name = "lib",
    crate_name = "nmp_store",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal=True) + ["//crates/nmp-grammar:lib"],
    proc_macro_deps = all_crate_deps(proc_macro=True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "example_codec_bench",
    srcs = ["examples/codec_bench.rs"],
    crate_root = "examples/codec_bench.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev=True, proc_macro_dev=True),
    deps = all_crate_deps(normal=True, normal_dev=True) + ["//crates/nmp-grammar:lib", ":lib"],
    proc_macro_deps = all_crate_deps(proc_macro=True, proc_macro_dev=True),
    rustc_flags = ["--cfg", 'feature="test-instrumentation"'],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

