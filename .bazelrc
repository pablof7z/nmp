# Bazel rc for NMP. The authoritative build is `bazel test //...`; Cargo stays
# the dependency-metadata authority via crate_universe (see MODULE.bazel).

# Select the pinned nightly toolchain registered in MODULE.bazel
# (nightly/2026-07-07, matching rust-toolchain.toml). rules_rust defaults to the
# stable channel, so this flag is what makes Bazel use the same compiler Cargo
# does. Universal scope so it applies to every configuration.
common --@rules_rust//rust/toolchain/channel:channel=nightly

# A shared disk cache so concurrent git worktrees reuse compiled artifacts
# without cross-worktree contamination (see the concurrent-worktree proof
# test). The cache key is the action digest, which is independent of the
# workspace path, so two worktrees building the same action hit one store.
common --disk_cache=~/.cache/bazel-nmp-diskcache

# Bound it. The disk cache has no size limit by default and only grows -- it
# reached 14G during the four-round concurrent-worktree proof alone, and the
# most expensive operational failure this repo has had was a disk filling to
# 100%, which broke every tool call rather than just the build. Bazel collects
# it down to this size once the server has been idle for
# --experimental_disk_cache_gc_idle_delay (5m).
common --experimental_disk_cache_gc_max_size=50G

# Keep Bazel's own output symlinks out of Cargo's `target/` to avoid the two
# build systems fighting over the same directory tree.
build --symlink_prefix=bazel-
test --symlink_prefix=bazel-

# Color output for terminal use.
common --color=yes

# --- Lint and format ---------------------------------------------------------
# The two workflows a developer would otherwise reach for Cargo to get. Both
# are aspects, so they apply to every Rust target reached by the pattern:
#   bazel build //... --config=clippy      (was: cargo clippy --workspace)
#   bazel build //... --config=fmt-check   (was: cargo fmt --check)
#   bazel run //:fmt                       (was: cargo fmt -- rewrites in place)
# clippy runs on the same pinned nightly as the build, so a lint that fires
# here fires in the editor too.
build:clippy --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:clippy --output_groups=+clippy_checks
# Warnings are errors: a lint nobody must act on is not a lint.
build:clippy --@rules_rust//rust/settings:clippy_flags=-Dwarnings

build:fmt-check --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
build:fmt-check --output_groups=+rustfmt_checks

# --- Cross-compilation -------------------------------------------------------
# The FFI slices the Swift xcframework and the Android AAR are assembled from.
# The triples come from native/features.toml -- Cargo's manifest of what the
# shipped artifact contains -- so this list and that one describe one thing.
#   bazel build --config=ios-device     //crates/nmp-ffi:nmp_ffi_static
#   bazel build --config=ios-sim-arm64  //crates/nmp-ffi:nmp_ffi_static
#   bazel build --config=android-arm64  //crates/nmp-ffi:nmp_ffi_cdylib
#
# The deployment targets are NOT defaults: with nothing set, rustc stamps the
# object's LC_BUILD_VERSION with the SDK version (iOS 26.5 on this Xcode),
# which produces a slice no iOS 16 app can link. native/features.toml declares
# `.iOS(.v16)` / macOS 13.0, so those are the numbers, and `vtool -show-build`
# on a member object is how you check.
# rustc reads the deployment target from its own process environment, and
# rules_rust does not pass Bazel's `--action_env` through to it, so this has
# to be `extra_rustc_env` -- which also scopes it to the non-exec
# configuration, leaving host tool builds alone.
#
# Two flags per platform, because the slice contains objects from two
# compilers: `extra_rustc_env` covers everything rustc emits, and
# `--ios_minimum_os` covers the C/assembly objects the cc toolchain builds
# (ring's poly1305, curve25519 and friends). Setting only the first leaves a
# staticlib whose Rust objects say 16.0 and whose C objects say 26.5.
build:ios-device --platforms=//platforms:ios_arm64
build:ios-device --@rules_rust//rust/settings:extra_rustc_env=IPHONEOS_DEPLOYMENT_TARGET=16.0
build:ios-device --ios_minimum_os=16.0
build:ios-sim-arm64 --platforms=//platforms:ios_sim_arm64
build:ios-sim-arm64 --@rules_rust//rust/settings:extra_rustc_env=IPHONEOS_DEPLOYMENT_TARGET=16.0
build:ios-sim-arm64 --ios_minimum_os=16.0
build:ios-sim-x86_64 --platforms=//platforms:ios_sim_x86_64
build:ios-sim-x86_64 --@rules_rust//rust/settings:extra_rustc_env=IPHONEOS_DEPLOYMENT_TARGET=16.0
build:ios-sim-x86_64 --ios_minimum_os=16.0
build:macos-arm64 --platforms=//platforms:macos_arm64
build:macos-arm64 --@rules_rust//rust/settings:extra_rustc_env=MACOSX_DEPLOYMENT_TARGET=13.0
build:macos-arm64 --macos_minimum_os=13.0
build:android-arm64 --platforms=//platforms:android_arm64
build:android-x86_64 --platforms=//platforms:android_x86_64