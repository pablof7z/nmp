# The platforms NMP cross-compiles the FFI artifact for.
#
# One platform per slice named in native/features.toml: the Apple
# xcframework's device/simulator/macOS slices and the two Android ABIs.
# Selected with the matching `--config=` in .bazelrc, e.g.
#   bazel build --config=ios-device //crates/nmp-ffi:nmp_ffi_static
#
# `aarch64-apple-ios` and `aarch64-apple-ios-sim` share an OS and a CPU, so
# @apple_support//constraints:device vs :simulator is the only thing that
# tells them apart -- rules_rust selects its toolchain on exactly that pair
# (rust/platform/triple_mappings.bzl), which is why these are not
# interchangeable and why a simulator build must not be assumed to prove a
# device build.

package(default_visibility = ["//visibility:public"])

platform(
    name = "ios_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:ios",
        "@apple_support//constraints:device",
    ],
)

platform(
    name = "ios_sim_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:ios",
        "@apple_support//constraints:simulator",
    ],
)

platform(
    name = "ios_sim_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:ios",
        "@apple_support//constraints:simulator",
    ],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:osx",
    ],
)

platform(
    name = "android_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:android",
    ],
)

platform(
    name = "android_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:android",
    ],
)
