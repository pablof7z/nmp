# First-party BUILD for the `nmp-runtime` crate. Third-party deps come from
# @crates via all_crate_deps(); first-party path deps are explicit.

load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "lib",
    crate_name = "nmp_runtime",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal=True) + ["//crates/nmp-engine:lib", "//crates/nmp-grammar:lib", "//crates/nmp-local-signer:lib", "//crates/nmp-nip11:lib", "//crates/nmp-resolver:lib", "//crates/nmp-router:lib", "//crates/nmp-router-testkit:lib", "//crates/nmp-signer:lib", "//crates/nmp-store:lib", "//crates/nmp-transport:lib"],
    proc_macro_deps = all_crate_deps(proc_macro=True),
    compile_data = ["Cargo.toml"],
    rustc_flags = ["--cfg", 'feature="unstable-mechanism"'],
    visibility = ["//visibility:public"],
)
