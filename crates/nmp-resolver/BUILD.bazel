# First-party BUILD for the `nmp-resolver` crate. Third-party deps come from
# @crates via all_crate_deps(); first-party path deps are explicit.

load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

rust_library(
    name = "lib",
    crate_name = "nmp_resolver",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    aliases = aliases(),
    deps = all_crate_deps(normal=True) + ["//crates/nmp-grammar:lib", "//crates/nmp-store:lib"],
    proc_macro_deps = all_crate_deps(proc_macro=True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "example_derived_limit_bench",
    srcs = ["examples/derived_limit_bench.rs"],
    crate_root = "examples/derived_limit_bench.rs",
    edition = crate_edition(),
    aliases = aliases(normal_dev=True, proc_macro_dev=True),
    deps = all_crate_deps(normal=True, normal_dev=True) + ["//crates/nmp-grammar:lib", "//crates/nmp-store:lib", ":lib", "//crates/nmp-resolver-testkit:lib", "//crates/nmp-test-support:lib"],
    proc_macro_deps = all_crate_deps(proc_macro=True, proc_macro_dev=True),
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
