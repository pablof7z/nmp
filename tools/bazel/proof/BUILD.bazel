# Concurrent-worktree disk-cache proof target.
#
# `printer` is a tiny binary whose printed value comes from a `const VALUE` in
# main.rs. The proof script (run_proof.sh) creates two git worktrees and edits
# VALUE in each to a distinct string, so each worktree's `printer` binary prints
# a different value. `hex` is a shared third-party dependency identical across
# worktrees: its compile action has the same digest in both, so the shared
# Bazel disk cache (`--disk_cache`, set in .bazelrc) serves it to the second
# worktree as a cache hit, while each worktree's own `printer` binary is
# recompiled from its own distinct source -- the combination proves the disk
# cache is shared across worktrees WITHOUT cross-worktree output contamination.
#
# This package is hand-maintained (not generated by gen_buildfiles.py): it is a
# Bazel-only proof harness, not a Cargo workspace member.

load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "printer",
    srcs = ["main.rs"],
    edition = "2021",
    deps = ["@crates//:hex"],
    visibility = ["//visibility:public"],
)